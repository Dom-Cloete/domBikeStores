<!-- ===== PRODUCT MODALS ===== -->
<!-- Create -->
<div class="modal fade" id="createProductModal">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm("CreateProduct", "Maintain", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5>Add New Product</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label>Product Name</label>
                    <input name="product_name" class="form-control mb-2" placeholder="Product Name" required />

                    <label>Brand</label>
                    <select name="brand_id" class="form-control mb-2" required>
                        @foreach (var b in Model.Brands)
                        {
                            <option value="@b.brand_id">@b.brand_name</option>
                        }
                    </select>

                    <label>Category</label>
                    <select name="category_id" class="form-control mb-2" required>
                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.category_id">@c.category_name</option>
                        }
                    </select>

                    <label>Model Year</label>
                    <input name="model_year" type="number" min="1900" max="@DateTime.Now.Year" class="form-control mb-2" placeholder="e.g., 2025" required />

                    <label>List Price</label>
                    <input name="list_price" type="number" step="0.01" min="0" class="form-control mb-2" placeholder="e.g., 999.99" required />
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Add</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            }
        </div>
    </div>
</div>

